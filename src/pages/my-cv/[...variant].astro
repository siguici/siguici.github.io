---
import {
  CV_LOCALES,
  CV_PROFILES,
  CV_TEMPLATES,
  DEFAULT_CV_LOCALE,
  DEFAULT_CV_PROFILE,
  DEFAULT_CV_TEMPLATE,
} from '../../config/cv';

import { getCVData, type Locale, type ProfileType } from '../../data/cv';

import { resolveCV } from '../../data/cv/resolver';

import { type CVTemplate, templates } from '../../templates/cv';

export function getStaticPaths() {
  const paths = [];

  for (const locale of CV_LOCALES) {
    for (const profile of CV_PROFILES) {
      for (const template of CV_TEMPLATES) {
        if (
          locale === DEFAULT_CV_LOCALE &&
          profile === DEFAULT_CV_PROFILE &&
          template === DEFAULT_CV_TEMPLATE
        ) {
          paths.push({
            params: {
              variant: undefined,
            },
            props: {
              locale,
              profile,
              template,
            },
          });

          continue;
        }

        if (
          profile === DEFAULT_CV_PROFILE &&
          template === DEFAULT_CV_TEMPLATE
        ) {
          paths.push({
            params: {
              variant: locale,
            },
            props: {
              locale,
              profile,
              template,
            },
          });

          continue;
        }

        const segments = [
          locale,
          profile,
          ...(template === DEFAULT_CV_TEMPLATE ? [] : [template]),
        ];

        paths.push({
          params: {
            variant: segments.join('/'),
          },
          props: {
            locale,
            profile,
            template,
          },
        });
      }
    }
  }

  return paths;
}

interface Props {
  locale: Locale;
  profile: ProfileType;
  template: CVTemplate;
}

const { locale, profile, template } = Astro.props as Props;

const { data } = getCVData(profile, locale);

const cv = resolveCV(profile, locale);

const Template = templates[template];

if (!Template) {
  throw new Error(`Unknown CV template: ${template}`);
}
---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{data.title}</title>

    <meta
      name="description"
      content={data.tagline}
    />
  </head>

  <body>
    <Template cv={cv} />
  </body>
</html>
