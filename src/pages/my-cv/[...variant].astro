---
import { getCVData, type Locale, type ProfileType } from '../../data/cv';

import { resolveCV } from '../../data/cv/resolver';

import { type CVTemplate, templates } from '../../templates/cv';

export function getStaticPaths() {
  const locales = ['fr', 'en'] as const;

  const profiles = ['master', 'data-scientist', 'data-analyst'] as const;

  const templates = ['default', 'modern', 'compact'] as const;

  const paths = [];

  for (const locale of locales) {
    for (const profile of profiles) {
      for (const template of templates) {
        if (locale === 'fr' && profile === 'master' && template === 'default') {
          paths.push({
            params: {
              variant: undefined,
            },
            props: {
              locale,
              profile,
              template,
            },
          });

          continue;
        }

        if (profile === 'master' && template === 'default') {
          paths.push({
            params: {
              variant: locale,
            },
            props: {
              locale,
              profile,
              template,
            },
          });

          continue;
        }

        const variant = [
          locale,
          profile,
          ...(template === 'default' ? [] : [template]),
        ].join('/');

        paths.push({
          params: {
            variant,
          },
          props: {
            locale,
            profile,
            template,
          },
        });
      }
    }
  }

  return paths;
}

interface Props {
  locale: Locale;
  profile: ProfileType;
  template: CVTemplate;
}

const { locale, profile, template } = Astro.props as Props;

const { data } = getCVData(profile, locale);

const cv = resolveCV(profile, locale);

const Template = templates[template];

if (!Template) {
  throw new Error(`Unknown CV template: ${template}`);
}
---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{data.title}</title>

    <meta
      name="description"
      content={data.tagline}
    />
  </head>

  <body>
    <Template cv={cv} />
  </body>
</html>
