---
import type { Locale, ProfileType } from '../../data/cv';

import { resolveCV } from '../../data/cv/resolver';

import { type CVTemplate, templates } from '../../templates/cv';

const locales = ['fr', 'en'] as const;

const profiles = ['master', 'data-scientist', 'data-analyst'] as const;

const templateNames = ['default', 'modern', 'compact'] as const;

type PageProps = {
  locale: Locale;
  profile: ProfileType;
  template: CVTemplate;
};

export function getStaticPaths() {
  const paths: Array<{
    params: {
      variant?: string;
    };
    props: PageProps;
  }> = [];

  for (const locale of locales) {
    for (const profile of profiles) {
      for (const template of templateNames) {
        if (locale === 'fr' && profile === 'master' && template === 'default') {
          paths.push({
            params: {
              variant: undefined,
            },
            props: {
              locale,
              profile,
              template,
            },
          });

          continue;
        }

        if (profile === 'master' && template === 'default') {
          paths.push({
            params: {
              variant: locale,
            },
            props: {
              locale,
              profile,
              template,
            },
          });

          continue;
        }

        const segments = [
          locale,
          profile,
          ...(template === 'default' ? [] : [template]),
        ];

        paths.push({
          params: {
            variant: segments.join('/'),
          },
          props: {
            locale,
            profile,
            template,
          },
        });
      }
    }
  }

  return paths;
}

const { locale, profile, template } = Astro.props;

const cv = resolveCV(profile, locale);

const Template = templates[template];

if (!Template) {
  throw new Error(`CV template "${template}" does not exist.`);
}
---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{cv.meta.title}</title>

    <meta
      name="description"
      content={cv.identity.tagline}
    />
  </head>

  <body>
    <Template {cv} />
  </body>
</html>
