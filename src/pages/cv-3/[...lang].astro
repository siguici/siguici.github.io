---
import AppLayout from '../../layouts/AppLayout.astro';
import common from '../../data/cv/common';
import getCV, { type Locale } from '../../data/cv';

interface Props {
	lang: Locale;
}

export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { lang: 'fr' } },
    { params: { lang: 'fr' }, props: { lang: 'fr' } },
    { params: { lang: 'en' }, props: { lang: 'en' } },
  ];
}

const { lang } = Astro.props as { lang: Locale };
const cv = getCV(lang);
---

<AppLayout title={cv.title}>
  <main class="max-w-5xl mx-auto px-4 py-8 sm:px-6 lg:px-8 space-y-12 font-sans text-slate-800 dark:text-slate-100">
    
    <header class="border-b border-slate-200 dark:border-slate-800 pb-8 space-y-4">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
            {common.identity.name}
          </h1>
          <p class="text-lg font-medium text-indigo-600 dark:text-indigo-400 mt-1">
            {cv.subtitle}
          </p>
        </div>
        
        <div class="flex items-center gap-3">
          <a
            href={`./${lang === 'fr' ? 'en' : 'fr'}`}
            class="px-3 py-1.5 text-xs font-semibold rounded-md bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition"
          >
            {lang === 'fr' ? 'English 🇺🇸' : 'Français 🇫🇷'}
          </a>
          <a
            href={common.contact.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 text-xs font-semibold text-white bg-slate-900 dark:bg-slate-100 dark:text-slate-900 rounded-md hover:opacity-90 transition"
          >
            GitHub
          </a>
        </div>
      </div>

      <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed max-w-3xl">
        {cv.tagline}
      </p>

      <div class="flex flex-wrap gap-y-2 gap-x-6 text-xs sm:text-sm text-slate-500 dark:text-slate-400 pt-2">
        <span class="flex items-center gap-1.5">
          📍 {cv.location}
        </span>
        <span class="flex items-center gap-1.5">
          💼 {cv.availability}
        </span>
        <a href={`mailto:${common.contact.email}`} class="hover:text-indigo-500 transition">
          ✉️ {common.contact.email}
        </a>
        <a href={common.contact.webUrl} target="_blank" class="hover:text-indigo-500 transition">
          🌐 {common.contact.web}
        </a>
      </div>
    </header>

    <section class="space-y-3">
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white uppercase text-xs font-semibold tracking-wider text-indigo-600 dark:text-indigo-400">
        {cv.sections.profile}
      </h2>
      <div
        class="prose dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed"
        set:html={cv.summary}
      />
    </section>

    <section class="space-y-4">
      <h2 class="text-xs font-semibold tracking-wider text-indigo-600 dark:text-indigo-400 uppercase">
        {cv.sections.strengths}
      </h2>
      <div class="flex flex-wrap gap-2">
        {cv.strengths.map((strength) => (
          <span class="px-3 py-1 text-xs font-medium rounded-full bg-indigo-50 dark:bg-indigo-950/50 text-indigo-700 dark:text-indigo-300 border border-indigo-100 dark:border-indigo-900">
            {strength}
          </span>
        ))}
      </div>
    </section>

    <hr class="border-slate-200 dark:border-slate-800" />

    <section class="space-y-4">
      <h2 class="text-xs font-semibold tracking-wider text-indigo-600 dark:text-indigo-400 uppercase">
        {cv.sections.capabilities}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {cv.capabilities.map((cap) => (
          <div class="p-4 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 space-y-1">
            <h3 class="font-semibold text-slate-900 dark:text-white text-sm">
              {cap.title}
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              {cap.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-6">
      <h2 class="text-xs font-semibold tracking-wider text-indigo-600 dark:text-indigo-400 uppercase">
        {cv.sections.experience}
      </h2>
      
      <div class="space-y-8">
        {cv.experiences.map((exp) => (
          <article class="relative pl-4 border-l-2 border-indigo-500/30 space-y-2">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
              <h3 class="text-base font-bold text-slate-900 dark:text-white">
                {exp.role} <span class="text-indigo-600 dark:text-indigo-400">@ {exp.company}</span>
              </h3>
              <span class="text-xs font-mono text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded w-fit">
                {exp.period}
              </span>
            </div>

            {exp.subtitle && (
              <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
                {exp.subtitle}
              </p>
            )}

            {exp.description && (
              <p class="text-sm text-slate-700 dark:text-slate-300">
                {exp.description}
              </p>
            )}

            {exp.impacts && exp.impacts.length > 0 && (
              <ul class="space-y-1.5 pt-2">
                {exp.impacts.map((impact) => (
                  <li class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 flex items-start gap-2">
                    <span class="text-indigo-500 mt-1">▸</span>
                    <span set:html={impact} />
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>

    <hr class="border-slate-200 dark:border-slate-800" />

    <section class="space-y-4">
      <h2 class="text-xs font-semibold tracking-wider text-indigo-600 dark:text-indigo-400 uppercase">
        {cv.sections.projects}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {cv.projects.map((project) => (
          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-indigo-500/50 transition bg-white dark:bg-slate-900 space-y-2 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between">
                <h3 class="font-bold text-slate-900 dark:text-white text-sm">
                  {project.name}
                </h3>
                <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                  {project.type}
                </span>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">
                {project.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="text-xs font-semibold tracking-wider text-indigo-600 dark:text-indigo-400 uppercase">
        {cv.sections.ecosystem}
      </h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {common.ecosystem.map((cat) => (
          <div class="p-3.5 rounded-lg bg-slate-50 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800 space-y-2">
            <h3 class="text-xs font-bold text-slate-900 dark:text-slate-200 capitalize">
              {cv.categories[cat.category as keyof typeof cv.categories] || cat.category}
            </h3>
            <ul class="space-y-1">
              {cat.skills.map((skill) => (
                <li class="text-[11px] text-slate-600 dark:text-slate-400 flex items-center gap-1.5">
                  <span class="w-1 h-1 rounded-full bg-indigo-500"></span>
                  {skill}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="text-xs font-semibold tracking-wider text-indigo-600 dark:text-indigo-400 uppercase">
        {cv.sections.education}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {cv.education.map((edu) => (
          <div class="p-3.5 rounded-lg border border-slate-200 dark:border-slate-800 space-y-1">
            <span class="text-[10px] font-mono text-slate-400 block">{edu.period}</span>
            <h3 class="text-xs font-bold text-slate-900 dark:text-white">{edu.degree}</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">{edu.institution}</p>
          </div>
        ))}
      </div>
    </section>

  </main>
</AppLayout>
