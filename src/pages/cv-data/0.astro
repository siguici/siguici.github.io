---
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout
  title="CV — Data Scientist / Data Analyst"
  cssClass="bg-neutral-100 text-slate-800 antialiased min-h-screen flex flex-col items-center justify-center p-0 sm:p-6 print:p-0"
  >
  <!-- Bouton d'impression à l'écran -->
  <div
    class="no-print mb-4 w-full max-w-[210mm] flex justify-between items-center px-4 sm:px-0"
  >
    <span
      class="text-xs font-semibold text-rose-600 bg-rose-50 px-2.5 py-1 rounded"
      >VERSION 5 : DATA SCIENTIST / DATA ANALYST</span
    >
    <button
      type="button"
      onclick="window.print()"
      class="bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold py-2 px-4 rounded-md shadow-sm"
    >
      Imprimer / PDF
    </button>
  </div>

  <!-- Conteneur principal A4 -->
  <main
    class="cv-container w-[210mm] h-[297mm] bg-white shadow-2xl print:shadow-none box-border flex overflow-hidden"
  >
    <!-- COLONNE GAUCHE (Sidebar Moderne) -->
    <aside
      class="w-[72mm] bg-slate-50 border-r border-slate-200/80 p-6 flex flex-col justify-between shrink-0"
    >
      <div>
        <!-- EN-TÊTE / NOM -->
        <div class="mb-6">
          <h1
            class="text-xl font-bold tracking-tight text-slate-950 leading-snug"
          >
            Kessé Emmanuel<br><span class="text-rose-600">SIGUI</span>
          </h1>
          <p
            class="text-[11px] font-semibold text-slate-600 uppercase tracking-wider mt-2"
          >
            Data Scientist / Data Analyst
          </p>
        </div>

        <!-- CONTACT & LIENS -->
        <div class="mb-6 space-y-2 text-[11px] text-slate-600 font-medium">
          <p
            class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2"
          >
            Contact
          </p>
          <div>📍 Abidjan, Côte d'Ivoire</div>
          <div>
            ✉️
            <a href="mailto:sikessem@gmail.com" class="hover:text-rose-600"
              >sikessem@gmail.com</a
            >
          </div>
          <div>📞 +225 07 49 28 88 35</div>
          <div class="pt-1">
            🌐
            <a href="https://github.com/siguici" class="hover:text-rose-600"
              >github.com/siguici</a
            >
          </div>
          <div>
            🔗
            <a href="https://siguici.github.io" class="hover:text-rose-600"
              >siguici.github.io</a
            >
          </div>
        </div>

        <!-- POINTS FORTS DATA -->
        <div class="mb-6">
          <p
            class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2"
          >
            Points forts
          </p>
          <ul class="text-[11px] text-slate-700 space-y-1.5 font-medium">
            <li>• Analyse Exploratoire de Données (EDA)</li>
            <li>• Machine Learning & Modélisation</li>
            <li>• Visualisation de données & KPIs</li>
            <li>• Traitement de données (Pandas/NumPy)</li>
            <li>• Requêtage SQL complexe (PostgreSQL)</li>
          </ul>
        </div>

        <!-- STACK TECHNIQUE -->
        <div class="mb-6">
          <p
            class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2"
          >
            Stack Data & Tools
          </p>
          <div class="flex flex-wrap gap-1">
            <span
              class="px-2 py-0.5 bg-rose-50 text-rose-700 text-[10px] font-bold rounded"
              >Python</span
            >
            <span
              class="px-2 py-0.5 bg-rose-50 text-rose-700 text-[10px] font-bold rounded"
              >Pandas / NumPy</span
            >
            <span
              class="px-2 py-0.5 bg-rose-50 text-rose-700 text-[10px] font-bold rounded"
              >Scikit-Learn</span
            >
            <span
              class="px-2 py-0.5 bg-slate-200/70 text-slate-800 text-[10px]"
              >SQL / PostgreSQL</span
            >
            <span
              class="px-2 py-0.5 bg-slate-200/70 text-slate-800 text-[10px]"
              >Data Mining</span
            >
            <span
              class="px-2 py-0.5 bg-slate-200/70 text-slate-800 text-[10px]"
              >Business Intelligence</span
            >
            <span
              class="px-2 py-0.5 bg-slate-200/70 text-slate-800 text-[10px]"
              >Git</span
            >
            <span
              class="px-2 py-0.5 bg-slate-200/70 text-slate-800 text-[10px]"
              >Docker</span
            >
            <span
              class="px-2 py-0.5 bg-slate-200/70 text-slate-800 text-[10px]"
              >PHP / Laravel</span
            >
          </div>
        </div>

        <!-- FORMATION (Mise en avant) -->
        <div class="mb-6">
          <p
            class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2"
          >
            Formation Académique
          </p>
          <div class="space-y-2 text-[10.5px]">
            <div>
              <p class="font-bold text-slate-900 leading-tight">
                Mastère 1 Big Data & Data Science
              </p>
              <p class="text-slate-500 mt-0.5">
                Leaders University — Tunisie
              </p>
              <p class="text-[9.5px] text-slate-400 font-medium">
                2022 – 2023
              </p>
            </div>
            <div>
              <p class="font-bold text-slate-900 leading-tight">
                Licence Business Intelligence
              </p>
              <p class="text-slate-500 mt-0.5">
                Mediterranean Institute of Tunisia
              </p>
              <p class="text-[9.5px] text-slate-400 font-medium">
                2019 – 2022
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- LANGUES -->
      <div class="pt-3 border-t border-slate-200/60">
        <p
          class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1"
        >
          Langues
        </p>
        <p class="text-[11px] text-slate-700 font-medium">
          <span class="font-bold text-slate-900">Français :</span>
          Courant •
          <span class="font-bold text-slate-900">Anglais :</span>
          Technique
        </p>
      </div>
    </aside>

    <!-- COLONNE DROITE (Contenu Principal) -->
    <section class="flex-1 p-7 flex flex-col justify-between">
      <div>
        <!-- PROFIL PROFESSIONNEL -->
        <div class="mb-6">
          <h2
            class="text-xs font-bold uppercase tracking-wider text-rose-600 mb-2 flex items-center gap-2"
          >
            <span>//</span>
            Profil Professionnel
          </h2>
          <p
            class="text-[11.5px] leading-relaxed text-slate-700 font-normal border-l-2 border-rose-500/30 pl-3"
          >
            Diplômé en Big Data, Data Science et Business Intelligence, je
            combine des compétences avancées en analyse quantitative avec une
            expérience solide en ingénierie logicielle. Passionné par
            l'extraction de valeur à partir de données brutes, je conçois des
            analyses exploratoires, des modèles prédictifs et des tableaux de
            bord stratégiques pour éclairer les décisions métier.
          </p>
        </div>

        <!-- EXPÉRIENCES & PROJETS DATA -->
        <div>
          <h2
            class="text-xs font-bold uppercase tracking-wider text-rose-600 mb-4 flex items-center gap-2"
          >
            <span>//</span>
            Projets & Applications Data Science / Analytics
          </h2>

          <div class="space-y-5">
            <!-- Melanoderme -->
            <article
              class="print-avoid relative pl-4 border-l border-slate-200"
            >
              <div
                class="absolute -left-[4.5px] top-1 w-2 h-2 rounded-full bg-rose-600"
              ></div>
              <div class="flex justify-between items-baseline mb-1">
                <h3 class="text-xs font-bold text-slate-950">
                  Data Analyst & Concepteur
                </h3>
                <span
                  class="text-[10px] font-semibold text-rose-600 bg-rose-50 px-2 py-0.5 rounded"
                  >Melanoderme</span
                >
              </div>
              <p class="text-[10.5px] font-semibold text-slate-500 mb-1.5">
                Analyse de Marché & Modélisation des Données d'Annonces
              </p>
              <ul class="text-[11px] text-slate-700 space-y-1.5 leading-snug">
                <li class="flex items-start gap-1.5">
                  <span class="text-slate-400 shrink-0">›</span>
                  <span
                    >Collecte, nettoyage et analyse des données d'offres du
                    marché ivoirien pour identifier les catégories clés et
                    comportements utilisateurs.</span
                  >
                </li>
                <li class="flex items-start gap-1.5">
                  <span class="text-slate-400 shrink-0">›</span>
                  <span
                    >Conception des métriques de pertinence et de classement
                    pour l'optimisation des moteurs de recherche d'annonces.</span
                  >
                </li>
                <li class="flex items-start gap-1.5">
                  <span class="text-slate-400 shrink-0">›</span>
                  <span
                    >Mise en place de règles d'agrégation SQL pour le suivi
                    analytique de la modération et de l'activité des vendeurs.</span
                  >
                </li>
              </ul>
            </article>

            <!-- Ahlabik -->
            <article
              class="print-avoid relative pl-4 border-l border-slate-200"
            >
              <div
                class="absolute -left-[4.5px] top-1 w-2 h-2 rounded-full bg-slate-300"
              ></div>
              <div class="flex justify-between items-baseline mb-1">
                <h3 class="text-xs font-bold text-slate-950">
                  Lead Analyst & Développeur
                </h3>
                <span
                  class="text-[10px] font-semibold text-slate-700 bg-slate-100 px-2 py-0.5 rounded"
                  >Ahlabik</span
                >
              </div>
              <p class="text-[10.5px] font-semibold text-slate-500 mb-1.5">
                Analyse des Ventes, KPIs E-Commerce & Suivi Comportemental
              </p>
              <ul class="text-[11px] text-slate-700 space-y-1.5 leading-snug">
                <li class="flex items-start gap-1.5">
                  <span class="text-slate-400 shrink-0">›</span>
                  <span
                    >Analyse du parcours d'achat (conversion, abandons de
                    panier, produits les plus consultés) pour guider les choix
                    stratégiques.</span
                  >
                </li>
                <li class="flex items-start gap-1.5">
                  <span class="text-slate-400 shrink-0">›</span>
                  <span
                    >Traitement des flux de données transactionnelles et
                    structuration du stockage des événements d'achat.</span
                  >
                </li>
                <li class="flex items-start gap-1.5">
                  <span class="text-slate-400 shrink-0">›</span>
                  <span
                    >Suivi de la performance des paiements Mobile Money et
                    identification des anomalies de transaction.</span
                  >
                </li>
              </ul>
            </article>

            <!-- Sikessem -->
            <article
              class="print-avoid relative pl-4 border-l border-slate-200"
            >
              <div
                class="absolute -left-[4.5px] top-1 w-2 h-2 rounded-full bg-slate-300"
              ></div>
              <div class="flex justify-between items-baseline mb-1">
                <h3 class="text-xs font-bold text-slate-950">
                  Ingénieur Logiciel & Scripting Data
                </h3>
                <span
                  class="text-[10px] font-semibold text-slate-700 bg-slate-100 px-2 py-0.5 rounded"
                  >Sikessem</span
                >
              </div>
              <p class="text-[10.5px] font-semibold text-slate-500 mb-1.5">
                Pipelines d'Extraction & Traitement Automatisé en Python
              </p>
              <ul class="text-[11px] text-slate-700 space-y-1.5 leading-snug">
                <li class="flex items-start gap-1.5">
                  <span class="text-slate-400 shrink-0">›</span>
                  <span
                    >Développement de scripts d'automatisation en Python pour
                    l'extraction, la transformation et le chargement de
                    données (ETL).</span
                  >
                </li>
                <li class="flex items-start gap-1.5">
                  <span class="text-slate-400 shrink-0">›</span>
                  <span
                    >Expérimentation de paquets de manipulation de données et
                    création d'outils d'intégration modulaires.</span
                  >
                </li>
              </ul>
            </article>
          </div>
        </div>
      </div>

      <!-- BAS DE PAGE -->
      <footer
        class="pt-3 border-t border-slate-100 flex justify-between items-center text-[10px] text-slate-400"
      >
        <span>Kessé Emmanuel SIGUI — Portfolio: siguici.github.io</span>
        <span>2026</span>
      </footer>
    </section>
  </main>
</AppLayout>
<style>
/* Configuration stricte pour impression PDF A4 mono-page */
@page {
  size: A4 portrait;
  margin: 0;
}

@media print {
  html,
  body {
    width: 210mm;
    height: 297mm;
    background: #ffffff !important;
    color: #0f172a !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }

  .cv-container {
    padding: 0 !important;
    box-shadow: none !important;
    border: none !important;
    width: 210mm !important;
    height: 297mm !important;
  }

  .no-print {
    display: none !important;
  }

  a {
    text-decoration: none !important;
    color: inherit !important;
  }
}

body {
  font-family: "Inter", sans-serif;
}

.print-avoid {
  break-inside: avoid;
  page-break-inside: avoid;
}
</style>
