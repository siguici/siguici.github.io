<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>CV - Sigui Kessé Emmanuel</title>
    <style>
        @page {
            size: A4;
            margin: 0;
            @bottom-right {
                content: "Page " counter(page) " / " counter(pages);
                font-family: 'Segoe UI', Roboto, Helvetica, sans-serif;
                font-size: 7.5pt;
                font-weight: 600;
                color: #94a3b8;
                padding-right: 20mm;
                padding-bottom: 10mm;
            }
        }
        
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #ffffff;
            color: #334155;
            font-size: 9.5pt;
            line-height: 1.5;
            -webkit-print-color-adjust: exact;
        }

        /* Top Hero Banner */
        .hero-banner {
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
            color: #ffffff;
            padding: 30mm 20mm 20mm 20mm;
            position: relative;
            border-bottom: 5px solid #6366f1;
        }

        .hero-banner::after {
            content: "";
            position: absolute;
            bottom: 0;
            right: 0;
            width: 150px;
            height: 150px;
            background: rgba(99, 102, 241, 0.1);
            border-radius: 100% 0 0 0;
        }

        .name-container {
            max-width: 800px;
        }

        .name {
            font-size: 28pt;
            font-weight: 800;
            letter-spacing: -1px;
            line-height: 1.1;
            text-transform: uppercase;
            color: #ffffff;
            margin: 0;
        }
        
        .name span {
            color: #818cf8;
        }

        .subtitle {
            font-size: 13.5pt;
            font-weight: 400;
            color: #cbd5e1;
            margin-top: 8px;
            margin-bottom: 0;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        /* Master Container */
        .main-container {
            display: table;
            width: 100%;
            padding: 0 15mm;
            margin-top: 10mm;
        }

        .columns-row {
            display: table-row;
        }

        /* Left Side: Main Content */
        .left-col {
            display: table-cell;
            width: 65%;
            padding-right: 12mm;
            vertical-align: top;
        }

        /* Right Side: Showcase & Core Details */
        .right-col {
            display: table-cell;
            width: 35%;
            background-color: #fafafa;
            border-left: 1px solid #f1f5f9;
            padding-left: 10mm;
            padding-right: 5mm;
            vertical-align: top;
            border-radius: 8px;
        }

        /* Section Styling */
        h2 {
            font-size: 12pt;
            font-weight: 700;
            color: #0f172a;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 25px;
            margin-bottom: 15px;
            padding-bottom: 6px;
            border-bottom: 2px solid #e2e8f0;
            position: relative;
            page-break-after: avoid;
        }

        h2::after {
            content: "";
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 40px;
            height: 2px;
            background-color: #4f46e5;
        }

        .section-desc {
            font-size: 9.5pt;
            color: #475569;
            margin-bottom: 20px;
            text-align: justify;
        }

        /* Blocks */
        .experience-item {
            margin-bottom: 22px;
            page-break-inside: avoid;
        }

        .item-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 4px;
        }

        .item-title {
            font-size: 11pt;
            font-weight: 700;
            color: #0f172a;
            margin: 0;
        }

        .item-company {
            font-size: 10pt;
            font-weight: 600;
            color: #4f46e5;
        }

        .item-date {
            font-size: 9pt;
            font-weight: 600;
            color: #64748b;
            float: right;
        }

        .item-bullets {
            margin: 8px 0 0 0;
            padding-left: 16px;
        }

        .item-bullets li {
            margin-bottom: 5px;
            color: #334155;
            text-align: justify;
        }

        .info-block {
            margin-bottom: 20px;
        }

        .info-label {
            font-size: 8.5pt;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #64748b;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .info-value {
            font-size: 10pt;
            color: #0f172a;
            font-weight: 500;
            margin-bottom: 10px;
        }

        .skill-group {
            margin-bottom: 15px;
        }

        .skill-group-title {
            font-size: 9pt;
            font-weight: 700;
            color: #1e1b4b;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .tag {
            display: inline-block;
            background-color: #eef2ff;
            color: #4338ca;
            font-size: 8.5pt;
            font-weight: 600;
            padding: 4px 10px;
            margin-right: 5px;
            margin-bottom: 6px;
            border-radius: 6px;
            border: 1px solid #e0e7ff;
        }
        
        .tag-dark {
            background-color: #f1f5f9;
            color: #1e293b;
            border: 1px solid #e2e8f0;
        }

        .project-card {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 12px;
            margin-bottom: 12px;
            page-break-inside: avoid;
        }

        .project-name {
            font-size: 10pt;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 4px;
        }

        .project-desc {
            font-size: 9pt;
            color: #475569;
            margin: 0;
            text-align: justify;
        }
    </style>
</head>
<body>
    <!-- Le contenu HTML complet est encapsulé dans le PDF ci-dessus -->
</body>
</html>
