        <option value="cv-laravel">
          1. Développeur PHP / Laravel / Fullstack
        </option>
        <option value="cv-architect">
          2. Architecte Logiciel Backend & DDD
        </option>
        <option value="cv-devops">3. Ingénieur DevOps, Cloud & Infra</option>
        <option value="cv-dataengineer">
          4. Data Engineer & BDD Architect
