<script>
  function switchVersion(versionId: string) {
    document
      .querySelectorAll('.cv-card')
      .forEach((card) => card.classList.remove('active'));
    const activeCard = document.getElementById(versionId);
    if (activeCard) activeCard.classList.add('active');
  }
  const versionSelect = document.getElementById('versionSelect') as HTMLSelectElement;
  versionSelect.addEventListener('change', function () {
    switchVersion(this.value);
  });
</script>
