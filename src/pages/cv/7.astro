<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CV — Emmanuel SIGUI — Software Architect & Platform Engineer</title>
  
  <style>
    /* =========================================================
       1. VARIABLES ET STYLES ÉCRAN (Dark Theme / Preview)
       ========================================================= */
    :root {
      --bg-color: #0a0a0a;
      --card-bg: #121212;
      --text-main: #e5e5e5;
      --text-muted: #a3a3a3;
      --accent: #7c3aed;
      --border-color: #262626;
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --font-mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: var(--font-sans);
      line-height: 1.5;
      font-size: 14px;
      padding: 2rem 1rem;
    }

    .cv-container {
      max-width: 800px;
      margin: 0 auto;
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 3rem;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
    }

    /* Actions Bar */
    .actions-bar {
      max-width: 800px;
      margin: 0 auto 1.5rem auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .btn-print {
      background-color: var(--accent);
      color: #ffffff;
      border: none;
      padding: 0.6rem 1.2rem;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      font-size: 0.9rem;
      transition: opacity 0.2s;
    }

    .btn-print:hover {
      opacity: 0.9;
    }

    .back-link {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.9rem;
    }

    .back-link:hover {
      color: var(--text-main);
    }

    /* Header */
    header {
      border-bottom: 2px solid var(--border-color);
      padding-bottom: 1.5rem;
      margin-bottom: 1.5rem;
    }

    h1 {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.025em;
      color: #ffffff;
    }

    .title-sub {
      font-size: 1.1rem;
      color: var(--accent);
      font-weight: 600;
      margin-top: 0.25rem;
    }

    .contact-info {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.5rem;
      margin-top: 1rem;
      font-size: 0.875rem;
      color: var(--text-muted);
    }

    .contact-info a {
      color: var(--text-muted);
      text-decoration: none;
    }

    .contact-info a:hover {
      color: var(--accent);
    }

    /* Sections */
    section {
      margin-bottom: 1.75rem;
    }

    h2 {
      font-size: 1.1rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--accent);
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 0.4rem;
      margin-bottom: 1rem;
    }

    p {
      color: var(--text-muted);
      margin-bottom: 0.5rem;
    }

    /* Experience & Projects */
    .item {
      margin-bottom: 1.25rem;
      break-inside: avoid;
    }

    .item-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 0.25rem;
    }

    .item-title {
      font-size: 1rem;
      font-weight: 700;
      color: #ffffff;
    }

    .item-company {
      font-weight: 600;
      color: var(--text-main);
    }

    .item-date {
      font-size: 0.85rem;
      color: var(--text-muted);
      font-family: var(--font-mono);
    }

    ul {
      list-style-type: disc;
      margin-left: 1.25rem;
      color: var(--text-muted);
    }

    li {
      margin-bottom: 0.25rem;
    }

    /* Expertise Grid */
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }

    .skill-category strong {
      color: var(--text-main);
      display: block;
      margin-bottom: 0.25rem;
    }

    /* =========================================================
       2. REGLES D'IMPRESSION STRICTES (Impression & PDF ATS)
       ========================================================= */
    @media print {
      @page {
        size: A4;
        margin: 12mm 15mm 12mm 15mm;
      }

      body {
        background-color: #ffffff !important;
        color: #111111 !important;
        font-family: Arial, Helvetica, sans-serif !important;
        font-size: 10.5pt !important;
        line-height: 1.4 !important;
        padding: 0 !important;
      }

      .actions-bar {
        display: none !important;
      }

      .cv-container {
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
      }

      header {
        border-bottom: 1.5pt solid #111111 !important;
        padding-bottom: 10pt !important;
        margin-bottom: 12pt !important;
      }

      h1 {
        color: #000000 !important;
        font-size: 20pt !important;
      }

      .title-sub {
        color: #333333 !important;
        font-size: 11pt !important;
      }

      .contact-info {
        color: #333333 !important;
        font-size: 9pt !important;
        margin-top: 6pt !important;
      }

      .contact-info a {
        color: #333333 !important;
        text-decoration: none !important;
      }

      h2 {
        color: #000000 !important;
        font-size: 11pt !important;
        border-bottom: 1pt solid #111111 !important;
        padding-bottom: 2pt !important;
        margin-bottom: 8pt !important;
        margin-top: 12pt !important;
      }

      p, li {
        color: #222222 !important;
      }

      .item-title {
        color: #000000 !important;
        font-size: 10.5pt !important;
      }

      .item-company {
        color: #111111 !important;
      }

      .item-date {
        color: #444444 !important;
        font-size: 9pt !important;
      }

      .skill-category strong {
        color: #000000 !important;
      }

      .item {
        break-inside: avoid !important;
      }
    }
  </style>
</head>
<body>

