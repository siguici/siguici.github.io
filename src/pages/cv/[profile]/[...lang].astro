---
import CV from '../../../components/CV.astro';
import { getCVData, type Locale, type ProfileType } from '../../../data/cv';

export function getStaticPaths() {
  const profiles: ProfileType[] = [
    'software-architect',
    'data-scientist',
    'data-analyst',
  ];
  const languages: Locale[] = ['fr', 'en'];

  return profiles.flatMap((profile) =>
    languages.map((lang) => ({
      params: { profile, lang },
      props: { profile, lang },
    })),
  );
}

const { profile, lang } = Astro.props;
const cv = getCVData(profile, lang).data;
---

<CV {cv} activeProfile={profile} activeLang={lang} />
