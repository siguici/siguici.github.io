---
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout
  title="CV — ARCHITECTURAL MANIFESTO & EOS RUNTIME"
  cssClass="bg-neutral-100"
  >
  <div class="max-w-[210mm] mx-auto bg-white p-10 text-[13px] leading-6">
    <header class="border-b pb-5">
      <h1 class="text-4xl font-bold">Kessé Emmanuel SIGUI</h1>
      <p class="text-lg text-slate-700 font-semibold">
        Développeur PHP/Laravel & Ingénieur Logiciel Backend
      </p>
      <p>Abidjan, Côte d'Ivoire • sikessem@gmail.com • +225 07 49 28 88 35</p>
      <p>github.com/siguici • siguici.github.io</p>
    </header>

    <section class="mt-6 print-avoid">
      <h2 class="text-xl font-bold border-b mb-2">Profil</h2>
      <p>
        Ingénieur logiciel backend spécialisé PHP/Laravel avec une expérience
        concrète dans la conception, le développement, le déploiement et la
        maintenance d'applications web et de plateformes SaaS en production.
        Je privilégie des architectures simples, maintenables et évolutives,
        adaptées aux besoins métier.
      </p>
    </section>

    <section class="mt-6 grid grid-cols-2 gap-6">
      <div class="print-avoid">
        <h2 class="text-xl font-bold border-b mb-2">Points forts</h2>
        <ul class="list-disc ml-5">
          <li>Laravel, PHP 8+, APIs REST</li>
          <li>Architecture modulaire (DDD)</li>
          <li>MySQL, PostgreSQL, Redis</li>
          <li>Docker, Git, Linux, CI/CD</li>
          <li>SaaS, e-commerce, marketplaces</li>
        </ul>
      </div>
      <div class="print-avoid">
        <h2 class="text-xl font-bold border-b mb-2">Technologies</h2>
        <p><b>Langages :</b> PHP, TypeScript, JavaScript, Python, Go, V</p>
        <p><b>Frameworks :</b> Laravel, Livewire, Alpine.js</p>
        <p><b>Bases :</b> MySQL, PostgreSQL, Redis</p>
      </div>
    </section>

    <section class="mt-6">
      <h2 class="text-xl font-bold border-b mb-3">Expériences & projets</h2>

      <div class="mb-5 print-avoid">
        <h3 class="font-bold">Fondateur & Ingénieur Logiciel — Sikessem</h3>
        <ul class="list-disc ml-5">
          <li>
            Conception d'une plateforme logicielle modulaire composée de
            composants backend réutilisables.
          </li>
          <li>Architecture orientée domaine (DDD).</li>
          <li>
            Création de bibliothèques open source en PHP, TypeScript, Go et V.
          </li>
        </ul>
      </div>

      <div class="mb-5 print-avoid">
        <h3 class="font-bold">
          Concepteur & Développeur Principal — Melanoderme
        </h3>
        <ul class="list-disc ml-5">
          <li>
            Architecture complète d'une plateforme d'annonces sous Laravel.
          </li>
          <li>
            Analyse du marché ivoirien pour orienter la recherche, la
            catégorisation et la modération.
          </li>
          <li>Base de code modulaire facilitant les évolutions.</li>
        </ul>
      </div>

      <div class="print-avoid">
        <h3 class="font-bold">Co‑Fondateur & Lead Développeur — Ahlabik</h3>
        <ul class="list-disc ml-5">
          <li>
            Conception, développement, déploiement et maintenance d'une
            plateforme e‑commerce Laravel en production.
          </li>
          <li>
            Gestion des catalogues, commandes, paniers et règles métier.
          </li>
          <li>
            Mise en place des environnements de déploiement et suivi de
            production.
          </li>
        </ul>
      </div>
    </section>

    <section class="mt-6 grid grid-cols-2 gap-6">
      <div>
        <h2 class="text-xl font-bold border-b mb-2">Formation</h2>
        <p>
          <b>Mastère 1 Big Data / Data Science</b><br>Leaders University —
          Nabeul (2022–2023)
        </p>
        <p class="mt-2">
          <b>Licence Business Intelligence</b><br>Mediterranean Institute of
          Tunisia — Nabeul (2019–2022)
        </p>
      </div>
      <div>
        <h2 class="text-xl font-bold border-b mb-2">Langues</h2>
        <p>Français : Courant</p>
        <p>Anglais : Technique</p>
      </div>
    </section>
  </div>
</AppLayout>

<style>
@page {
  size: A4;
  margin: 12mm;
}
body {
  font-family: Inter, Arial, sans-serif;
}
.print-avoid {
  break-inside: avoid;
  page-break-inside: avoid;
}
</style>
