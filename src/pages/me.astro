---
const { __ } = Astro.locals;
---

<!doctype html>
<html lang={Astro.currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{__('profile.meta.title')}</title>
    <meta name="description" content={__('profile.meta.description')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <main class="profile">
      <div class="ambient ambient-one"></div>
      <div class="ambient ambient-two"></div>
      <div class="grid"></div>

      <header class="topbar">
        <a href="/" class="brand">
          <span class="brand-mark">S</span>
          <span>SIGUI</span>
        </a>

        <div class="status">
          <span class="status-dot"></span>
          <span>{__('profile.status')}</span>
        </div>
      </header>

      <section class="hero">
        <div class="hero-index">00 / 01</div>

        <div class="hero-content">
          <p class="eyebrow">{__('profile.hero.eyebrow')}</p>

          <h1>
            {__('profile.hero.title.line1')}
            <span>{__('profile.hero.title.line2')}</span>
          </h1>

          <p class="intro">
            {__('profile.hero.intro')}
          </p>

          <div class="hero-actions">
            <a href="/my-cv" class="button button-primary">
              {__('profile.hero.cv')}
              <span>↗</span>
            </a>

            <a href="#contact" class="button button-secondary">
              {__('profile.hero.contact')}
            </a>
          </div>
        </div>

        <div class="hero-meta">
          <div>
            <span>{__('profile.hero.location.label')}</span>
            <strong>{__('profile.hero.location.value')}</strong>
          </div>

          <div>
            <span>{__('profile.hero.focus.label')}</span>
            <strong>{__('profile.hero.focus.value')}</strong>
          </div>
        </div>
      </section>

      <section class="identity-section">
        <div class="section-label">
          <span>01</span>
          <span>{__('profile.identity.label')}</span>
        </div>

        <div class="identity-grid">
          <div class="identity-title">
            <p>{__('profile.identity.kicker')}</p>
            <h2>{__('profile.identity.title')}</h2>
          </div>

          <div class="identity-copy">
            <p>{__('profile.identity.paragraph1')}</p>
            <p>{__('profile.identity.paragraph2')}</p>
          </div>
        </div>
      </section>

      <section class="systems-section">
        <div class="section-label">
          <span>02</span>
          <span>{__('profile.systems.label')}</span>
        </div>

        <div class="systems-grid">
          <article class="system-card system-main">
            <span class="system-number">01</span>

            <div>
              <p class="system-type">{__('profile.systems.sikessem.type')}</p>
              <h3>Sikessem</h3>
              <p>{__('profile.systems.sikessem.description')}</p>
            </div>

            <a href="https://sikessem.com" target="_blank" rel="noreferrer">
              {__('profile.systems.explore')} ↗
            </a>
          </article>

          <article class="system-card">
            <span class="system-number">02</span>

            <div>
              <p class="system-type">{__('profile.systems.loom.type')}</p>
              <h3>Loom</h3>
              <p>{__('profile.systems.loom.description')}</p>
            </div>

            <a href="https://loom.sikessem.com" target="_blank" rel="noreferrer">
              {__('profile.systems.explore')} ↗
            </a>
          </article>

          <article class="system-card">
            <span class="system-number">03</span>

            <div>
              <p class="system-type">{__('profile.systems.tooling.type')}</p>
              <h3>{__('profile.systems.tooling.title')}</h3>
              <p>{__('profile.systems.tooling.description')}</p>
            </div>

            <a href="https://github.com/siguici" target="_blank" rel="noreferrer">
              {__('profile.systems.explore')} ↗
            </a>
          </article>
        </div>
      </section>

      <section class="principles-section">
        <div class="section-label">
          <span>03</span>
          <span>{__('profile.principles.label')}</span>
        </div>

        <div class="principles">
          <article>
            <span>01</span>
            <h3>{__('profile.principles.systems.title')}</h3>
            <p>{__('profile.principles.systems.description')}</p>
          </article>

          <article>
            <span>02</span>
            <h3>{__('profile.principles.domain.title')}</h3>
            <p>{__('profile.principles.domain.description')}</p>
          </article>

          <article>
            <span>03</span>
            <h3>{__('profile.principles.product.title')}</h3>
            <p>{__('profile.principles.product.description')}</p>
          </article>

          <article>
            <span>04</span>
            <h3>{__('profile.principles.open.title')}</h3>
            <p>{__('profile.principles.open.description')}</p>
          </article>
        </div>
      </section>

      <section class="statement-section">
        <div class="statement-mark">“</div>

        <blockquote>
          {__('profile.statement')}
        </blockquote>

        <span>{__('profile.statement.author')}</span>
      </section>

      <section class="contact-section" id="contact">
        <div class="section-label">
          <span>04</span>
          <span>{__('profile.contact.label')}</span>
        </div>

        <div class="contact-content">
          <h2>{__('profile.contact.title')}</h2>

          <div class="contact-links">
            <a href="mailto:kessy.emmanuel@gmail.com">
              <span>{__('profile.contact.email')}</span>
              <strong>kessy.emmanuel@gmail.com ↗</strong>
            </a>

            <a
              href="https://github.com/siguici"
              target="_blank"
              rel="noreferrer"
            >
              <span>GitHub</span>
              <strong>@siguici ↗</strong>
            </a>

            <a
              href="https://linkedin.com/in/sigui-kesse-emmanuel"
              target="_blank"
              rel="noreferrer"
            >
              <span>LinkedIn</span>
              <strong>Sigui Kessé Emmanuel ↗</strong>
            </a>
          </div>
        </div>
      </section>

      <footer>
        <span>© {new Date().getFullYear()} SIGUI KESSÉ EMMANUEL</span>
        <span>{__('profile.footer')}</span>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    background: #070708;
  }

  :global(body) {
    margin: 0;
    background: #070708;
    color: #f4f4f0;
    font-family: 'Manrope', sans-serif;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .profile {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 75% 15%, rgba(130, 255, 180, 0.08), transparent 28rem),
      radial-gradient(circle at 15% 70%, rgba(100, 140, 255, 0.06), transparent 30rem),
      #070708;
  }

  .grid {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.22;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 70px 70px;
    mask-image: linear-gradient(to bottom, black, transparent 80%);
  }

  .ambient {
    position: absolute;
    width: 28rem;
    height: 28rem;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
  }

  .ambient-one {
    top: 10rem;
    right: -15rem;
    background: rgba(90, 255, 160, 0.08);
  }

  .ambient-two {
    top: 70rem;
    left: -15rem;
    background: rgba(80, 110, 255, 0.07);
  }

  .topbar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(1400px, calc(100% - 64px));
    margin: auto;
    padding: 30px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'DM Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
  }

  .brand-mark {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    font-size: 0.7rem;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 9px;
    color: rgba(255, 255, 255, 0.48);
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #7dffad;
    box-shadow: 0 0 15px rgba(125, 255, 173, 0.7);
  }

  .hero,
  .identity-section,
  .systems-section,
  .principles-section,
  .statement-section,
  .contact-section,
  footer {
    position: relative;
    z-index: 1;
    width: min(1400px, calc(100% - 64px));
    margin: auto;
  }

  .hero {
    display: grid;
    grid-template-columns: 120px 1fr 260px;
    gap: 40px;
    min-height: 800px;
    padding: 130px 0 120px;
  }

  .hero-index,
  .section-label,
  .eyebrow,
  .hero-meta span,
  .system-type,
  .contact-links span,
  footer {
    font-family: 'DM Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .hero-index {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.65rem;
  }

  .hero-content {
    max-width: 850px;
  }

  .eyebrow {
    margin: 0 0 35px;
    color: #8affb5;
    font-size: 0.68rem;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(4rem, 8vw, 9rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.075em;
  }

  h1 span {
    display: block;
    color: rgba(255, 255, 255, 0.28);
  }

  .intro {
    max-width: 610px;
    margin: 55px 0 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 40px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    padding: 15px 20px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: 250ms ease;
  }

  .button-primary {
    border-color: #8affb5;
    background: #8affb5;
    color: #070708;
  }

  .button-secondary:hover,
  .button-primary:hover {
    transform: translateY(-3px);
  }

  .button-secondary:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .hero-meta {
    align-self: end;
    display: grid;
    gap: 30px;
    padding-bottom: 15px;
  }

  .hero-meta div {
    display: grid;
    gap: 9px;
  }

  .hero-meta span {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.58rem;
  }

  .hero-meta strong {
    font-size: 0.8rem;
    font-weight: 500;
  }

  .identity-section,
  .systems-section,
  .principles-section,
  .contact-section {
    padding: 130px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
  }

  .section-label {
    display: flex;
    gap: 18px;
    margin-bottom: 70px;
    color: rgba(255, 255, 255, 0.35);
    font-size: 0.62rem;
  }

  .section-label span:first-child {
    color: #8affb5;
  }

  .identity-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
  }

  .identity-title p {
    margin: 0 0 20px;
    color: rgba(255, 255, 255, 0.3);
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    max-width: 700px;
    font-size: clamp(2.8rem, 5vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .identity-copy {
    color: rgba(255, 255, 255, 0.58);
    font-size: 1rem;
    line-height: 1.9;
  }

  .identity-copy p {
    margin: 0 0 25px;
  }

  .systems-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 1px;
    background: rgba(255, 255, 255, 0.1);
  }

  .system-card {
    display: flex;
    min-height: 420px;
    flex-direction: column;
    justify-content: space-between;
    padding: 32px;
    background: #0b0b0d;
    transition: 300ms ease;
  }

  .system-card:hover {
    background: #101013;
  }

  .system-number {
    color: rgba(255, 255, 255, 0.25);
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
  }

  .system-type {
    margin-bottom: 15px;
    color: #8affb5;
    font-size: 0.58rem;
  }

  .system-card h3 {
    margin: 0 0 20px;
    font-size: 2.2rem;
    letter-spacing: -0.05em;
  }

  .system-card p:not(.system-type) {
    max-width: 400px;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.7;
  }

  .system-card a {
    width: fit-content;
    color: rgba(255, 255, 255, 0.55);
    font-family: 'DM Mono', monospace;
    font-size: 0.62rem;
    text-transform: uppercase;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 70px 100px;
  }

  .principles article {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 25px;
  }

  .principles article > span {
    color: #8affb5;
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
  }

  .principles h3 {
    margin: 0 0 15px;
    font-size: 1.35rem;
  }

  .principles p {
    margin: 0;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.75;
  }

  .statement-section {
    padding: 180px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }

  .statement-mark {
    color: #8affb5;
    font-size: 6rem;
    line-height: 0.5;
  }

  blockquote {
    max-width: 1100px;
    margin: 50px 0;
    font-size: clamp(2.5rem, 5vw, 5.5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.06em;
  }

  .statement-section > span {
    color: rgba(255, 255, 255, 0.35);
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  .contact-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
  }

  .contact-links {
    display: grid;
  }

  .contact-links a {
    display: grid;
    gap: 10px;
    padding: 22px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .contact-links span {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.58rem;
  }

  .contact-links strong {
    font-size: 0.95rem;
    font-weight: 500;
  }

  footer {
    display: flex;
    justify-content: space-between;
    padding: 35px 0;
    color: rgba(255, 255, 255, 0.25);
    font-size: 0.55rem;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding: 90px 0;
    }

    .hero-index {
      display: none;
    }

    .hero-meta {
      grid-template-columns: 1fr 1fr;
      margin-top: 80px;
    }

    .identity-grid,
    .contact-content {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .systems-grid {
      grid-template-columns: 1fr;
    }

    .principles {
      grid-template-columns: 1fr;
      gap: 45px;
    }
  }

  @media (max-width: 600px) {
    .topbar,
    .hero,
    .identity-section,
    .systems-section,
    .principles-section,
    .statement-section,
    .contact-section,
    footer {
      width: min(100% - 36px, 1400px);
    }

    h1 {
      font-size: clamp(3.5rem, 18vw, 6rem);
    }

    .hero-meta {
      grid-template-columns: 1fr;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .button {
      justify-content: space-between;
    }

    .identity-section,
    .systems-section,
    .principles-section,
    .contact-section {
      padding: 90px 0;
    }

    .statement-section {
      padding: 120px 0;
    }

    footer {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
